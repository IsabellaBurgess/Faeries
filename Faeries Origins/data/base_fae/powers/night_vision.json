{
    "name": "§a§l§nNight Vision",
    "description": "Your fae ancestry allows you to see in the dark.",
    "badges": [
        {
            "sprite": "origins:textures/gui/badge/toggle.png",
            "text": "Toggle with [Shift] + %s"
        }
    ],
    "type": "origins:multiple",
    "resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 1
    },
    "key0": {
        "condition": {
            "type": "origins:sneaking"
        },
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_resource",
                "comparison": "<",
                "compare_to": 1
            },
            "if_action": {
                "type": "origins:change_resource",
                "resource": "*:*_resource",
                "change": 1,
                "operation": "add"
            },
            "else_action": {
                "type": "origins:change_resource",
                "resource": "*:*_resource",
                "change": -1,
                "operation": "add"
            }
        },
        "key": "key.origins.secondary_active"
    },
    "key1": {
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_resource",
            "comparison": ">=",
            "compare_to": 1
        },
        "type": "origins:night_vision",
        "strength": 1
    }
}