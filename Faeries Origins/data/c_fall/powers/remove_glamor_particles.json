{
    "type": "origins:action_over_time",
    "interval": 1,
    "condition": {
        "type": "origins:glowing"
    },
    "entity_action": {
        "type": "origins:and",
        "actions": [
            {
                "type": "origins:execute_command",
                "command": "power grant @s c_fall:disguise_particles"
            },
            {
                "type": "sync:remove_disguise",
                "command": "power remove @s c_fall:disguise_menu"
            },
            {
                "type": "origins:execute_command",
                "command": "scale reset"
            },
            {
                "type": "origins:execute_command",
                "command": "power remove @s c_fall:remove_glamor_particles"
            }
        ]
    }
}