{
    "name": "Switch Skins",
    "description": "Switch between your different skins with the click of a button",
    "badges": [
        {
            "sprite": "origins:textures/gui/badge/active.png",
            "text": "Open the menu with %s"
        }
    ],
    "type": "origins:multiple",
    "wheel": {
        "type": "origins:active_self",
        "key": {
            "key": "key.origins.quaternary_active"
        },
        "entity_action": {
            "type": "sync:radial_menu",
            "entries": [
                {
                    "icon": "players:textures/gui/sierra_braid_icon.png",
                    "entity_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:execute_command",
                                "command": "power remove @s custom_skins:sierra_skins_magical_girl"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "power grant @s custom_skins:sierra_skins_braided"
                            }
                        ]
                    },
                    "tooltip": "Braids",
                    "button_width": 22,
                    "button_height": 24,
                    "icon_width": 20,
                    "icon_height": 20,
                    "button_texture": "players:textures/gui/unseelie_button.png",
                    "highlight_button_texture": "players:textures/gui/unseelie_button_selected.png"
                },
                {
                    "icon": "players:textures/gui/sierra_magical_girl_icon.png",
                    "entity_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:execute_command",
                                "command": "particle dust 0.05 0.33 0.67 1 ~ ~1 ~ 0.3 0.6 0.3 0.4 200 normal"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "particle dust 0.05 0.68 0.57 1 ~ ~1 ~ 0.3 0.6 0.3 0.4 100 normal"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "particle dust 0.98 0.8 0.33 1 ~ ~1 ~ 0.3 0.6 0.3 0.4 100 normal"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "particle dust 0.99 0.91 0.32 1 ~ ~1 ~ 0.3 0.6 0.3 0.4 100 normal"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "power remove @s custom_skins:sierra_skins_braided"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "power grant @s custom_skins:sierra_skins_magical_girl"
                            }
                        ]
                    },
                    "tooltip": "Magical Girl",
                    "button_width": 22,
                    "button_height": 24,
                    "icon_width": 20,
                    "icon_height": 20,
                    "button_texture": "players:textures/gui/unseelie_button.png",
                    "highlight_button_texture": "players:textures/gui/unseelie_button_selected.png"
                },
                {
                    "icon": "players:textures/gui/sierra_icon.png",
                    "entity_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:execute_command",
                                "command": "power revoke @s custom_skins:sierra_skins_magical_girl"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "power revoke @s custom_skins:sierra_skins_braided"
                            }
                        ]
                    },
                    "tooltip": "Default",
                    "button_width": 22,
                    "button_height": 24,
                    "icon_width": 20,
                    "icon_height": 20,
                    "button_texture": "players:textures/gui/unseelie_button.png",
                    "highlight_button_texture": "players:textures/gui/unseelie_button_selected.png"
                }
            ]
        }
    }
}