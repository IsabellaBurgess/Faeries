{
    "name": "§a§l§nNature Spirit",
    "description": "As a spirit of the forest, you can phase through leaves and wood.",
    "badges": [
        {
            "sprite": "origins:textures/gui/badge/toggle.png",
            "text": "Toggle with %s"
        }
    ],
    "type": "origins:multiple",
    "resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "min_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "title @s actionbar {\"text\": \"You can no longer phase through blocks\", \"color\": \"red\"}"
                },
                {
                    "type": "origins:execute_command",
                    "command": "power remove @s seelie:nature_phase"
                }
            ]
        },
        "max_action": {
            "type": "origins:execute_command",
            "command": "power grant @s seelie:nature_phase"
        }
    },
    "key0": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_resource",
                "comparison": "<",
                "compare_to": 1
            },
            "if_action": {
                "type": "origins:change_resource",
                "resource": "*:*_resource",
                "change": 1,
                "operation": "add"
            },
            "else_action": {
                "type": "origins:change_resource",
                "resource": "*:*_resource",
                "change": -1,
                "operation": "add"
            }
        },
        "key": "key.origins.primary_active"
    }
}