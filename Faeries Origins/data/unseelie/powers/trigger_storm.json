{
    "name": "§a§l§nSummon Storm",
    "description": "By focusing your magic, you are able to summon a brief rainstorm that lasts 2.5 minutes. This allows you to teleport without worrying about the light of the sun.",
    "badges": [
        {
            "sprite": "origins:textures/gui/badge/active.png",
            "text": "Use with [Shift] + %s"
        }
    ],
    "type": "origins:multiple",
    "resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 3000,
        "max_action": {
            "type": "origins:execute_command",
            "command": "weather clear"
        }
    },
    "summon": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "weather rain"
                },
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_resource",
                    "change": 0,
                    "operation": "set"
                }
            ]
        },
        "key": {
            "key": "key.origins.primary_active"
        },
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 9
        },
        "cooldown": 12000,
        "condition": {
            "type": "origins:sneaking"
        }
    },
    "timer": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_resource",
            "change": 1
        }
    }
}