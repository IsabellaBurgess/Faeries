{
    "name": "§1§l§nHunger",
    "description": "Food sounds less appealing than it did. What if you followed the example of the forest? What if you consumed a creatures life force?",
    "badges": [
        {
            "sprite": "origins:textures/gui/badge/info.png",
            "text": "Restore hunger by pressing %s. Doing so will cost experience."
        }
    ],
    "type": "origins:multiple",
    "no_cake": {
        "type": "origins:action_on_block_use",
        "entity_action": {
            "type": "origins:apply_effect",
            "effects": [
                {
                    "effect": "minecraft:hunger",
                    "duration": 400,
                    "amplifier": 1
                },
                {
                    "effect": "minecraft:nausea",
                    "duration": 200
                }
            ]
        },
        "block_condition": {
            "type": "origins:or",
            "conditions": [
                {
                    "type": "origins:block",
                    "block": "minecraft:cake"
                },
                {
                    "type": "origins:in_tag",
                    "tag": "minecraft:candle_cakes"
                }
            ]
        }
    },
    "no_food": {
        "type": "origins:modify_food",
        "item_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:food"
                },
                {
                    "type": "origins:ingredient",
                    "ingredient": {
                        "item": "minecraft:chorus_fruit"
                    },
                    "inverted": true
                }
            ]
        },
        "entity_action": {
            "type": "origins:apply_effect",
            "effects": [
                {
                    "effect": "minecraft:hunger",
                    "duration": 600,
                    "amplifier": 2
                },
                {
                    "effect": "minecraft:nausea",
                    "duration": 400
                }
            ]
        }
    },
    "consume_use": {
        "type": "origins:active_self",
        "key": {
            "key": "key.origins.quaternary_active"
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:xp_levels",
                    "comparison": ">=",
                    "compare_to": 3
                },
                {
                    "type": "origins:food_level",
                    "comparison": "<",
                    "compare_to": 20
                }
            ]
        },
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:feed",
                    "food": 5,
                    "saturation": 5
                },
                {
                    "type": "origins:execute_command",
                    "command": "xp add @s -18 points"
                }
            ]
        }
    }
}